{
  "name": "talaria",
  "version": "0.1.5",
  "description": "Orchestrate coding-agent sessions on remote machines over Tailscale and SSH.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MFoxx/talaria.git"
  },
  "homepage": "https://github.com/MFoxx/talaria#readme",
  "bugs": {
    "url": "https://github.com/MFoxx/talaria/issues"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "orchestration",
    "ssh",
    "tailscale"
  ],
  "type": "module",
  "bin": {
    "talaria": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^15.0.0",
    "zod": "^4.5.1"
  }
}
